pipeline {

  agent {
    kubernetes {
      yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: maven
      image: maven:3.9.6-eclipse-temurin-11
      command:
        - cat
      tty: true
"""
    }
  }

  environment {
    GIT_REPO_URL = 'https://github.com/pablo-inchausti-caylent/liferay-portal.git'
    GIT_BRANCH   = 'master-ci-6005-postgresql'

    AWS_ACCOUNT_ID='300374333822'
    AWS_REGION='us-east-2'

    COMPOSE_FILE = '02-docker-compose.yaml'

  }

  options {
    skipDefaultCheckout()
  }

  stages {


    stage('Install AWS CLI and Test IRSA (optional) ') {
      steps {
        container('maven') {
          echo '📦 Installing AWS CLI  (if needed)...'
          sh '''
            apt-get update && apt-get install -y unzip curl
            curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
            unzip -q awscliv2.zip
            ./aws/install || echo "✅ AWS CLI may already be installed"
            aws --version || true 
            aws sts get-caller-identity || echo "❌ AWS CLI not configured or IRSA not working"
            aws s3 ls || echo "❌ AWS CLI S3 (IRSA) access not working"
          '''
        }
      }
    }


    stage('Install Docker ') {
      steps {
        container('maven') {
          echo '📦 Installing AWS CLI  (if needed)...'
          sh '''

              apt update && apt upgrade -y
              apt install -y ca-certificates curl gnupg lsb-release
              install -m 0755 -d /etc/apt/keyrings

              curl -fsSL https://download.docker.com/linux/ubuntu/gpg | \
                gpg --dearmor -o /etc/apt/keyrings/docker.gpg

              echo \
                "deb [arch=$(dpkg --print-architecture) \
                signed-by=/etc/apt/keyrings/docker.gpg] \
                https://download.docker.com/linux/ubuntu \
                $(lsb_release -cs) stable" | \
                tee /etc/apt/sources.list.d/docker.list > /dev/null

              apt update
              apt install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

          '''
        }
      }
    }




    stage('ECR Login') {
      steps {

        container('maven') {
            sh '''
              aws ecr get-login-password --region "$AWS_REGION" | \
                docker login --username AWS \
                        --password-stdin "$AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com"
            '''
          
        }
    
      }
    }




    stage('EFS Validation') {
      steps {


          sh 'ls -al'
          sh 'echo "Hello from the agent container"'

          sh '''
            df -h
            echo "🔍 Checking EFS mount at /home/jenkins/agent"
            mount | grep /home/jenkins/agent || echo "❌ EFS NOT mounted"
            echo "📄 Writing test file to EFS..."
            date > /home/jenkins/agent/test-efs-$(date +%s).txt
            ls -al /home/jenkins/agent
          '''
    
      }
    }


    


  }



}

/*
This Works Ok (18/06/2025)

This Jenkinsfile is designed to run in a Kubernetes environment with a Maven container.
It performs the following tasks:
  1. Installs the AWS CLI and tests if IRSA (IAM Roles for Service Accounts) is working.
  2. Installs Docker on the agent container.
  3. Logs into AWS ECR (Elastic Container Registry).
  4. Validates the EFS (Elastic File System) mount by checking if it
      is mounted, writing a test file, and listing the contents of the EFS mount point.
*/