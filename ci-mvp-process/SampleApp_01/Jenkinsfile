pipeline {

  agent {
    kubernetes {
      yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: maven
      image: maven:3.9.6-eclipse-temurin-11
      command:
        - cat
      tty: true
"""
    }
  }

  environment {
    GIT_REPO_URL = 'https://github.com/pablo-inchausti-caylent/liferay-portal.git'
    GIT_BRANCH   = 'master-ci-6005-postgresql'
  }

  options {
    skipDefaultCheckout()
  }

  stages {

    stage('sh Commands in the agent') {
      steps {

          sh 'ls -al'
          sh 'echo "Hello from the agent container"'
          sh 'pwd'
          sh 'mount | grep efs || echo "EFS not mounted"'
          sh 'df -h'
        
      }
    }

  

    


  }



}
