pipeline {
  agent {
    kubernetes {
      yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: maven
      image: maven:3.9.6-eclipse-temurin-11
      command:
        - cat
      tty: true
"""
    }
  }

  stages {

    /*
    stage('Checkout') {
      steps {
        container('maven') {
          git credentialsId: 'github-pat-pei', 
                        url: 'https://github.com/pablo-inchausti-caylent/liferay-portal.git', 
                     branch: 'master-ci-6005-postgresql'
        }
      }
    }
    */

    stage('Validate directory structure') {
      steps {
        container('maven') {
          dir('liferay-portal/') {
            sh 'ls -al'
          }
          dir('liferay-portal/ci-mvp-process/') {
            sh 'ls -al'
          }
        }
      }
    }

    stage('Build with Maven') {
      steps {
        container('maven') {
          dir('liferay-portal/ci-mvp-process/SampleApp_01') {
            sh 'ls -al'
            sh 'mvn -B package'
          }
        }
      }
    }

    stage('Run tests') {
      steps {
        container('maven') {
          dir('liferay-portal/ci-mvp-process/SampleApp_01') {
            sh 'mvn -B test'
          }
        }
      }
    }
    
  }



  post {
    always {
      container('maven') {
        dir('liferay-portal/ci-mvp-process/SampleApp_01') {
          junit '**/target/surefire-reports/*.xml'
        }
      }

      container('maven') {
        sh 'sleep 900' // Gives you 15 minutes to exec into the container
      }
    }
  }
}

