pipeline {

  agent {
    kubernetes {
      yaml """
apiVersion: v1
kind: Pod
metadata:
  annotations:
    eks.amazonaws.com/role-arn: arn:aws:iam::300374333822:role/jenkins-irsa-role
spec:
  serviceAccountName: jenkins-agent
  containers:
    - name: runner
      image: 300374333822.dkr.ecr.us-east-2.amazonaws.com/my-custom-kubectl:1.3
      command: ["cat"]
      tty: true
"""
    }
  }

  environment {
    GIT_REPO_URL = 'https://github.com/pablo-inchausti-caylent/liferay-portal.git'
    GIT_BRANCH   = 'master-ci-6005-postgresql'

    AWS_ACCOUNT_ID='300374333822'
    AWS_REGION='us-east-2'

    LIFERAY_RUNNER_STACK = 'ci-mvp-process/liferay-runner-stack.yaml'

  }

  options {
    skipDefaultCheckout()
  }

  stages {


    stage('Print Environment') {
      steps {
        script {
          // Print some common Jenkins env vars
          echo "Branch: ${env.BRANCH_NAME}"
          echo "Job Name: ${env.JOB_NAME}"
          echo "Build Number: ${env.BUILD_NUMBER}"
          echo "Workspace: ${env.WORKSPACE}"
          echo "Git Commit: ${env.GIT_COMMIT}"
        }
        // Or print everything
        // sh 'printenv'
      }
    }

    stage('Install AWS CLI and Test IRSA (optional) ') {
      steps {
        container('runner') {
          echo '📦 Validate AWS CLI and IRSA...'
          sh '''
            aws --version || true 
            aws sts get-caller-identity || echo "❌ AWS CLI not configured or IRSA not working"
            aws s3 ls || echo "❌ AWS CLI S3 (IRSA) access not working"
          '''
        }
      }
    }


    stage('Validate Kubectl ') {
      steps {
        container('runner') {
          echo '📦 Validate Kubectl ...'
          sh '''
              kubectl  version || true
          '''
        }
      }
    }


    stage('Checkout Shallow') {
      steps {
        container('runner') {
          checkout([
            $class: 'GitSCM',
            branches: [[name: "*/${env.GIT_BRANCH}"]],
            userRemoteConfigs: [[
              url: "${env.GIT_REPO_URL}",
              credentialsId: 'github-pat-pei'
            ]],
            extensions: [
              [$class: 'CloneOption', shallow: true, depth: 1, noTags: false, reference: '', timeout: 10]
            ]
          ])
        }
      }
    }
    

    stage('EFS Copy Validation') {
      steps {
        container('runner') {
          sh '''
            ls -al
            df -h
            echo "🔍 Checking EFS mount at /home/jenkins/agent"
            mount | grep /home/jenkins/agent || echo "❌ EFS NOT mounted"

            echo "📄 Writing test file to EFS..."
            date > /home/jenkins/agent/test-efs-bundle-$(date +%s).txt
            ls -al /home/jenkins/agent
          '''
        }
      }
    }


    stage('Run Kubectl - like docker compose v3 ') {
      steps {
        container('runner') {
         

            sh '''
                echo '📦 Running Stacks with Kubectl ...'
                ls -la
            '''

            sh '''
                echo "📦 Applying Liferay Runner Stack... 1"
                kubectl apply -f $LIFERAY_RUNNER_STACK -n liferay-jenkins
            '''

            sh """
                echo "📦 Get Into Liferay Runner Stack... 2"
                kubectl exec liferay-runner-pod -n liferay-jenkins -c runner \
                    -- bash -c \"
                        kubectl get pods -A



                      \"
            """

          
        }
      }
    }



 stage('Copy Liferay Portal Bundle to EFS') {
      steps {

          sh 'ls -al'
          sh 'echo "Hello from the agent container"'

          sh '''
            df -h
            echo "🔍 Checking EFS mount at /home/jenkins/agent"
            mount | grep /home/jenkins/agent || echo "❌ EFS NOT mounted"
           
            cp \
            /opt/dev/projects/github/liferay-portal/liferay-portal-bundle-tomcat.tar.gz \
            /home/jenkins/agent/

            ls -al /home/jenkins/agent
          '''
    
      }
    }


  }



}


/*

Build de Bundle
	mkdir -p /opt/dev/projects/github

	cd /opt/dev/projects/github


	git clone --depth 1 --no-tags --quiet -b master-ci-6005-postgresql git@github.com:michaelhashimoto/liferay-portal.git
	git clone --depth 1 --no-tags --quiet -b master git@github.com:liferay/liferay-jenkins-ee.git


	cd /opt/dev/projects/github/liferay-portal

	git clean -dfx

	echo "app.server.parent.dir=/opt/dev/projects/github/liferay-portal/bundles" > app.server.${HOSTNAME}.properties

	echo "liferay.home=/opt/dev/projects/github/liferay-portal/bundles" > build.${HOSTNAME}.properties
	echo "mirrors.hostname=" >> build.${HOSTNAME}.properties

	echo "java.jdk.default.runtime.version=jdk21" > test.${HOSTNAME}.properties

	ant setup-profile-dxp

	ant -f build-test-batch.xml dist-jdk7 -Daxis.variable=tomcat



# COPY TO EFS 

cp \ 
/opt/dev/projects/github/liferay-portal/liferay-portal-bundle-tomcat.tar.gz \
/home/jenkins/agent/

cp \
	/opt/dev/projects/github/liferay-portal/liferay-portal-source.tar.gz \
	/home/jenkins/agent/

	aws s3 cp --no-progress \
		/opt/dev/projects/github/liferay-portal/liferay-portal-bundle-tomcat.tar.gz \
		s3://liferayci-file-propagator/caylent/builds/[number]/liferay-portal-bundle-tomcat.tar.gz


	aws s3 cp --no-progress \
		/opt/dev/projects/github/liferay-portal/liferay-portal-source.tar.gz \
		s3://liferayci-file-propagator/caylent/builds/[number]/liferay-portal-source.tar.gz



*/


/*
This Jenkinsfile uses a Kubernetes agent to run the pipeline steps.

with a custom Docker image that includes kubectl as runner.
300374333822.dkr.ecr.us-east-2.amazonaws.com/my-custom-kubectl:1.1

It does the ECR login and th eother services threough IRSA

It includes stages for installing AWS CLI, Docker, and logging into AWS ECR.
The environment variables are set for the Git repository, AWS account, and region.

*/