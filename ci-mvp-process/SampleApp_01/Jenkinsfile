pipeline {

  agent {
    kubernetes {
      yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: maven
      image: maven:3.9.6-eclipse-temurin-11
      command:
        - cat
      tty: true
"""
    }
  }

  environment {
    GIT_REPO_URL = 'https://github.com/pablo-inchausti-caylent/liferay-portal.git'
    GIT_BRANCH   = 'master-ci-6005-postgresql'
  }

  options {
    skipDefaultCheckout()
  }

  stages {


    stage('Install AWS CLI and Test IRSA (optional) ') {
      steps {
        container('maven') {
          echo '📦 Installing AWS CLI (if needed)...'
          sh '''
            apt-get update && apt-get install -y unzip curl
            curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
            unzip -q awscliv2.zip
            ./aws/install || echo "✅ AWS CLI may already be installed"
            aws --version || true 
            aws sts get-caller-identity || echo "❌ AWS CLI not configured or IRSA not working"
            aws s3 ls || echo "❌ AWS CLI S3 (IRSA) access not working"
          '''
        }
      }
    }

    stage('EFS Validation') {
      steps {

          sh 'ls -al'
          sh 'echo "Hello from the agent container"'

          sh '''
            df -h
            echo "🔍 Checking EFS mount at /home/jenkins/agent"
            mount | grep /home/jenkins/agent || echo "❌ EFS NOT mounted"
            echo "📄 Writing test file to EFS..."
            date > /home/jenkins/agent/test-efs-$(date +%s).txt
            ls -al /home/jenkins/agent
          '''
    
      }
    }

  

    


  }



}
