@Library('Liferay-Global-Shared-Libs') _

import com.liferay.TestBuild

pipeline {

  agent {
    kubernetes {
      yaml """
apiVersion: v1
kind: Pod
metadata:
  name: jenkins-efs-agent
  securityContext:
    fsGroup: 1000
  labels:
    jenkins: agent
spec:
  serviceAccountName: jenkins-agent
  containers:
    - name: jnlp
      image: jenkins/inbound-agent:3309.v27b_9314fd1a_4-4
      volumeMounts:
        - mountPath: /home/jenkins/agent
          name: efs-workspace
    - name: runner
      image: 300374333822.dkr.ecr.us-east-2.amazonaws.com/my-custom-kubectl:2.1
      command: ["cat"]
      tty: true
      volumeMounts:
        - mountPath: /home/jenkins/agent
          name: efs-workspace
        - mountPath: /home/jenkins/local
          name: workspace-volume
  volumes:
    - name: efs-workspace
      persistentVolumeClaim:
        claimName: jenkins-efs-pvc
    - name: workspace-volume
      emptyDir: {}
"""
    }
  }


  environment {
    GIT_REPO_URL = 'https://github.com/pablo-inchausti-caylent/liferay-portal.git'
    GIT_BRANCH   = 'master-ci-6005-postgresql'

    AWS_ACCOUNT_ID='300374333822'
    AWS_REGION='us-east-2'

    AWS_S3_BUCKET='liferayci-file-propagator-mvp'
    AWS_S3_PATH='build'

    AWS_S3_URL_ARTIFACTS="s3://${AWS_S3_BUCKET}/${AWS_S3_PATH}/${env.BUILD_NUMBER}/artifacts"
    AWS_S3_URL_TESTS="s3://${AWS_S3_BUCKET}/${AWS_S3_PATH}/${env.BUILD_NUMBER}/tests"

    BUILD_BUNDLE_NAME='liferay-portal-bundle-tomcat.tar.gz'
    BUILD_SOURCE_NAME='liferay-portal-source.tar.gz'

    BUILD_BUNDLE_DUMMY_NAME="bundle-${BUILD_BUNDLE_NAME}"
    BUILD_SOURCE_DUMMY_NAME="bundle-${BUILD_SOURCE_NAME}"

    // s3://liferayci-file-propagator-mvp/build/35/artifacts
    // s3://liferayci-file-propagator-mvp/build/35/tests

    // liferay-portal-bundle-tomcat.tar.gz  (~1.7gb)
    // liferay-portal-source.tar.gz         (~1.2gb)

    DIR_LOCAL_CHECKOUT  = "/home/jenkins/local/checkout"
    EFS_WORKSPACE_DIR   = "/home/jenkins/agent/workspace/${env.JOB_NAME}-${env.BUILD_NUMBER}"
    TARBALL_FILE_NAME   = "liferay-portalrepo-${env.BUILD_NUMBER}.tar.gz"
    TARBALL_FILE_PATH   = "/home/jenkins/local/${TARBALL_FILE_NAME}"

  }

  options {
    skipDefaultCheckout()
    // ws "/home/jenkins/agent/workspace/${env.JOB_NAME}-${env.BUILD_NUMBER}"
    // ws "/home/jenkins/local/"
    
  }



  stages {

    stage('Print Environment') {
      steps {
        script {

          echo """
          Environment Variables:
          Branch      : ${env.BRANCH_NAME}
          Job Name    : ${env.JOB_NAME}
          Build Number: ${env.BUILD_NUMBER}
          Workspace   : ${env.WORKSPACE}
          Git Commit  : ${env.GIT_COMMIT}
          Node Name   : ${env.NODE_NAME}

          AWS_S3_URL_ARTIFACTS : ${env.AWS_S3_URL_ARTIFACTS}
          AWS_S3_URL_TESTS     : ${env.AWS_S3_URL_TESTS}
          """


          echo "Testing Shared Libs"

          log.info    'Validation Shared Libs Integration'
          log.warning 'Liferay-Global-Shared-Libs is working fine'
          
          echo "kubectl exec -it ${env.NODE_NAME} -c runner -n liferay-jenkins -- bash"
        }
        // Or print everything
        // sh 'printenv'
      }
    }

    stage('Validate AWS Cli, IRSA and Kubectl (optional) ') {
      steps {
        container('runner') {

          echo '📦 Validate AWS CLI and IRSA...'

          echo 'Using (Docker image 2.1) ... UPDATE to Version 2.6 '

          sh '''
            aws --version || true 
            aws sts get-caller-identity || echo "❌ AWS CLI not configured or IRSA not working"
            aws s3 ls || echo "❌ AWS CLI S3 (IRSA) access not working"
          '''

          echo '📦 Validate Kubectl ...'
          sh '''
              kubectl  version || true
          '''
        }
      }
    }
    

    stage('Checkout Shallow - today with SCM ') {
      steps {
        container('runner') {
          script {

            sh """
              echo "🧹 Cleaning local checkout path..."
              rm -rf ${DIR_LOCAL_CHECKOUT} && mkdir -p ${DIR_LOCAL_CHECKOUT}

              echo '📥 Cloning repository into local path...'
            """

            dir(DIR_LOCAL_CHECKOUT) {
              checkout([
                $class: 'GitSCM',
                branches: [[name: "*/${env.GIT_BRANCH}"]],
                userRemoteConfigs: [[
                  url: "${env.GIT_REPO_URL}",
                  credentialsId: 'github-pat-pei'
                ]],
                extensions: [
                  [$class: 'CloneOption', shallow: true, depth: 1, noTags: false, reference: '', timeout: 10]
                ]
              ])
            }

          }
        }
      }
    }



    stage('Post Checkout - using the files ') {
      steps {
        container('runner') {
          script {

            sh """
              echo "🧹 Reading local checkout path..."
              ls -la ${DIR_LOCAL_CHECKOUT}
            """


            sh """
               ls -al ${DIR_LOCAL_CHECKOUT}
              echo "📂 Local checkout contents:"
               
              echo "pigz --version || echo '❌ pigz not found'"

              echo '📦 Creating tarball without .git...'
              # tar -czf ${TARBALL_FILE_PATH} -C ${DIR_LOCAL_CHECKOUT} .
              tar --exclude='.git' -czf ${TARBALL_FILE_PATH} -C ${DIR_LOCAL_CHECKOUT} .

              echo '📤 Moving tarball to EFS workspace...'
              mkdir -p "${EFS_WORKSPACE_DIR}"
              mv ${TARBALL_FILE_PATH} "${EFS_WORKSPACE_DIR}/"

              echo '📂 Skipping extraction for now...'
              # tar -xzf "${TARBALL_FILE_PATH}" -C "${EFS_WORKSPACE_DIR}/"

              echo '📄 Final workspace contents:'
              ls -al "${EFS_WORKSPACE_DIR}"
            """

            sh """

              echo "🔍 Checking EFS mount at /home/jenkins/agent"
              mount | grep /home/jenkins/agent || echo "❌ EFS NOT mounted"

              date > /home/jenkins/agent/${BUILD_BUNDLE_DUMMY_NAME}
              echo "📄 GitRepo emulation ." >> /home/jenkins/agent/${BUILD_BUNDLE_DUMMY_NAME}

              date > /home/jenkins/agent/${BUILD_SOURCE_DUMMY_NAME}
              echo "📄 GitRepo emulation ." >> /home/jenkins/agent/${BUILD_SOURCE_DUMMY_NAME}
              
              ls -al /home/jenkins/agent
            """
          }
        }
      }
    }


    stage('Dynamic Downstream Builds') {
      steps {
        script {
                        
            echo "🔄 Starting dynamic downstream builds based on commit message..."
            echo "🔄 Using (Docker image 2.1) ... Version 2.5 "
            
            def commitMessage = "[test: NONE ]"
            // def commitMessage = "[test: ALL ]"
            // def commitMessage = "[test: test-01-unit, test-03-db]"
            // def commitMessage = "[test: test-01-unit]"

            try {
              commitMessage = sh(script: "git log -1 --pretty=%B", returnStdout: true).trim()
              echo "📩 Commit message found: ${commitMessage}"
            } catch (e) {
              echo "⚠️ Could not retrieve commit message. Using default: ${commitMessage}"
              echo "🔍 Reason: ${e.getMessage()}"
            }

            def selectedTests = TestBuild.fromCommitMessage(commitMessage) 

            echo "✅ Selected: ${selectedTests*.label.join(', ')}"

            def parallelJobs = [:]

            selectedTests.each { test ->
                def jobPath = TestBuild.getFullJobPath(test)
                def dirPath = TestBuild.getFullDirPath(test)

                echo "👉 Running: ${test.label}"
                echo "🔧 Job Path: ${jobPath}"
                echo "📁 Directory: ${dirPath}"

                build job: jobPath
            }

            parallel parallelJobs   // ← Jenkins waits for all to finish here

        }
      }
    }



  
    // stage('Upload to S3 - Artifacts') {

    //   steps {
    //     container('runner') {
    //       sh """
    //         echo "📤 Uploading to S3..."

    //         aws s3 cp /home/jenkins/agent/${BUILD_BUNDLE_DUMMY_NAME} \
    //           ${env.AWS_S3_URL_ARTIFACTS}/${BUILD_BUNDLE_DUMMY_NAME} || echo "❌ Upload failed"

    //         aws s3 cp /home/jenkins/agent/${BUILD_SOURCE_DUMMY_NAME} \
    //           ${env.AWS_S3_URL_ARTIFACTS}/${BUILD_SOURCE_DUMMY_NAME} || echo "❌ Upload failed"
    //       """
    //     }
    //   }
    // }


  }

    
  post {
    always {
      container('runner') {
        script {
          def podName = env.NODE_NAME
          sh """
            echo "🛑 Build complete. Pod is: ${podName}"
            echo "Run this to debug:"
            echo "kubectl exec -it ${podName} -n liferay-jenkins -- bash"
            sleep 3600
          """
        }
      }
    }
  }
  


}


