pipeline {
  agent any
  parameters {
    choice(name: 'PIPELINE_ENV', choices: ['main', 'test'], description: 'Select your environment')
  }
  stages {
    stage('Dispatch Environment') {
      steps {
        script {
          def target = "Jenkinsfile--top-Level.${params.PIPELINE_ENV}"
          echo "Loading pipeline for environment: ${params.PIPELINE_ENV}"
          load(target)
        }
      }
    }
  }
}