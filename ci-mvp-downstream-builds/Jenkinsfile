pipeline {


  agent {
    kubernetes {
      yaml """
apiVersion: v1
kind: Pod
metadata:
  annotations:
    eks.amazonaws.com/role-arn: arn:aws:iam::300374333822:role/jenkins-irsa-role
spec:
  serviceAccountName: jenkins-agent
  containers:
    - name: runner
      image: 300374333822.dkr.ecr.us-east-2.amazonaws.com/my-custom-kubectl:1.3
      command: ["cat"]
      tty: true
"""
    }
  }

  environment {
    GIT_REPO_URL = 'https://github.com/pablo-inchausti-caylent/liferay-portal.git'
    GIT_BRANCH   = 'master-ci-6005-postgresql'

    AWS_ACCOUNT_ID='300374333822'
    AWS_REGION='us-east-2'
    
  }

  options {
    skipDefaultCheckout()
  }


  stages {

    stage('Print Environment') {
      steps {
        script {
          echo "Branch: ${env.BRANCH_NAME}"
          echo "Job Name: ${env.JOB_NAME}"
          echo "Build Number: ${env.BUILD_NUMBER}"
          echo "Workspace: ${env.WORKSPACE}"
          echo "Git Commit: ${env.GIT_COMMIT}"
        }
      }
    }

    stage('Checkout Shallow') {
      steps {
        // container('runner') {
        //   checkout([
        //     $class: 'GitSCM',
        //     branches: [[name: "*/${env.GIT_BRANCH}"]],
        //     userRemoteConfigs: [[
        //       url: "${env.GIT_REPO_URL}",
        //       credentialsId: 'github-pat-pei'
        //     ]],
        //     extensions: [
        //       [$class: 'CloneOption', shallow: true, depth: 1, noTags: false, reference: '', timeout: 10]
        //     ]
        //   ])
        // }

        container('runner') {
          sh '''

            echo "🔍 Checking EFS mount at /home/jenkins/agent"
            mount | grep /home/jenkins/agent || echo "❌ EFS NOT mounted"

            date > /home/jenkins/agent/git-repo-emulation-gz.txt
            echo "📄 GitRepo emulation ." >> /home/jenkins/agent/git-repo-emulation-gz.txt

            ls -al /home/jenkins/agent
          '''
        }
      }
    }
    

    stage('Copy bundle to EFS - v4') {
      steps {
        container('runner') {
          sh '''
            ls -al
            df -h
            echo "🔍 Checking EFS mount at /home/jenkins/agent"
            mount | grep /home/jenkins/agent || echo "❌ EFS NOT mounted"

            echo "📄 Writing test file to EFS..."
            date > /home/jenkins/agent/test-efs-bundle.txt

            ls -al /home/jenkins/agent
          '''
        }
      }
    }

    stage('Trigger Downstream Builds (Dynamically)') {
      steps {
        script {

          def branch = 'master-ci-6005-postgresql'
          def jobs = ["MVP-Downstream-Build-1/${branch}", 
                      "MVP-Downstream-Build-2/${branch}",
                      "MVP-Downstream-Build-3/${branch}"]
          def parallelBuilds = [:]

          for (int i = 0; i < jobs.size(); i++) {
            def jobName = jobs[i]
            parallelBuilds["Build ${i+1}"] = {
              // ensure context is preserved
              script {
                echo "👉 Triggering downstream job: ${jobName}"
                build job: jobName, wait: true
              }
            }
          }

          parallel parallelBuilds
        }
      }
    }

    stage('Continue PoC -v6') {
      steps {
        echo '✅ All Downstream Build jobs done. Proceeding with PoC...'

        sh '''
            ls -al
            df -h
            echo "🔍 Checking EFS mount at /home/jenkins/agent"
            mount | grep /home/jenkins/agent || echo "❌ EFS NOT mounted"

            ls -al /home/jenkins/agent

            echo "📄 Reading test file from EFS..."
            cat /home/jenkins/agent/test-efs-bundle.txt

            echo "📄 Reading All test files from EFS..."
            cat /home/jenkins/agent/test-efs-bundle-*.txt          
        '''
      }
    }
  }
}


/*
This Jenkinsfile is designed to trigger multiple Downstream Build jobs in parallel.
Each Downstream Build job is executed in its own stage, allowing for concurrent execution.
And the Wait option is set to true, ensuring that the pipeline waits for each Downstream Build job to complete before proceeding.
This is useful for scenarios where you have multiple independent jobs that can run simultaneously, improving overall pipeline efficiency.
After all Downstream Build jobs are completed, the pipeline proceeds to the next stage, which can be used for further processing or deployment steps.
This structure allows for a clear and organized approach to managing multiple Downstream Build jobs within a single pipeline, making it easier to maintain and understand the flow of the CI/CD process.
*/