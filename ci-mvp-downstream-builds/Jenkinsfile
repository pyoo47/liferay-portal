@Library('Liferay-Global-Shared-Libs') _

pipeline {

  agent {
    kubernetes {
      yaml """
apiVersion: v1
kind: Pod
metadata:
  name: jenkins-efs-agent
  labels:
    jenkins: agent
spec:
  serviceAccountName: jenkins-agent
  containers:
    - name: jnlp
      image: jenkins/inbound-agent:3309.v27b_9314fd1a_4-4
      volumeMounts:
        - mountPath: /home/jenkins/agent
          name: efs-workspace
    - name: runner
      image: 300374333822.dkr.ecr.us-east-2.amazonaws.com/my-custom-kubectl:1.3
      command: ["cat"]
      tty: true
      volumeMounts:
        - mountPath: /home/jenkins/agent
          name: efs-workspace
  volumes:
    - name: efs-workspace
      persistentVolumeClaim:
        claimName: jenkins-efs-pvc
"""
    }
  }


  environment {
    GIT_REPO_URL = 'https://github.com/pablo-inchausti-caylent/liferay-portal.git'
    GIT_BRANCH   = 'master-ci-6005-postgresql'

    AWS_ACCOUNT_ID='300374333822'
    AWS_REGION='us-east-2'

    AWS_S3_BUCKET='liferayci-file-propagator-mvp'
    AWS_S3_PATH='build'

    AWS_S3_URL_ARTIFACTS="s3://${AWS_S3_BUCKET}/${AWS_S3_PATH}/${env.BUILD_NUMBER}/artifacts"
    AWS_S3_URL_TESTS="s3://${AWS_S3_BUCKET}/${AWS_S3_PATH}/${env.BUILD_NUMBER}/tests"

    BUILD_BUNDLE_NAME='liferay-portal-bundle-tomcat.tar.gz'
    BUILD_SOURCE_NAME='liferay-portal-source.tar.gz'

    BUILD_BUNDLE_DUMMY_NAME="dummy-${BUILD_BUNDLE_NAME}"
    BUILD_SOURCE_DUMMY_NAME="dummy-${BUILD_SOURCE_NAME}"

    // s3://liferayci-file-propagator-mvp/build/35/artifacts
    // s3://liferayci-file-propagator-mvp/build/35/tests

    // liferay-portal-bundle-tomcat.tar.gz  (~1.7gb)
    // liferay-portal-source.tar.gz         (~1.2gb)

  }

  options {
    skipDefaultCheckout()
  }

  stages {

    stage('Print Environment - v22 - with DWS buidls') {
      steps {
        script {

          echo "Testing Shared Libs"

          log.info 'Validation Liferay-Global-Shared-Libs'
          log.warning 'Nothing to do!'

          log.warning 'TODO - Read the EFS from a GUI ?'

          echo "Branch: ${env.BRANCH_NAME}"
          echo "Job Name: ${env.JOB_NAME}"
          echo "Build Number: ${env.BUILD_NUMBER}"
          echo "Workspace: ${env.WORKSPACE}"
          echo "Git Commit: ${env.GIT_COMMIT}"

          echo "AWS s3 ARTIFACTS URL: ${env.AWS_S3_URL_ARTIFACTS}"
          echo "AWS s3 TEST URL: ${env.AWS_S3_URL_TESTS}"
        }
        // Or print everything
        // sh 'printenv'
      }
    }

    stage('Validate AWS Cli, IRSA and Kubectl (optional) ') {
      steps {
        container('runner') {
          echo '📦 Validate AWS CLI and IRSA...'
          sh '''
            aws --version || true 
            aws sts get-caller-identity || echo "❌ AWS CLI not configured or IRSA not working"
            aws s3 ls || echo "❌ AWS CLI S3 (IRSA) access not working"
          '''

          echo '📦 Validate Kubectl ...'
          sh '''
              kubectl  version || true
          '''
        }
      }
    }
    

    stage('Checkout Shallow') {
      steps {
        // container('runner') {
        //   checkout([
        //     $class: 'GitSCM',
        //     branches: [[name: "*/${env.GIT_BRANCH}"]],
        //     userRemoteConfigs: [[
        //       url: "${env.GIT_REPO_URL}",
        //       credentialsId: 'github-pat-pei'
        //     ]],
        //     extensions: [
        //       [$class: 'CloneOption', shallow: true, depth: 1, noTags: false, reference: '', timeout: 10]
        //     ]
        //   ])
        // }

          sh """

            echo "🔍 Checking EFS mount at /home/jenkins/agent"
            mount | grep /home/jenkins/agent || echo "❌ EFS NOT mounted"

            date > /home/jenkins/agent/${BUILD_BUNDLE_DUMMY_NAME}
            echo "📄 GitRepo emulation ." >> /home/jenkins/agent/${BUILD_BUNDLE_DUMMY_NAME}

            date > /home/jenkins/agent/${BUILD_SOURCE_DUMMY_NAME}
            echo "📄 GitRepo emulation ." >> /home/jenkins/agent/${BUILD_SOURCE_DUMMY_NAME}
            
            ls -al /home/jenkins/agent
          """
        
      }
    }





    stage('Decide What to Run') {
      steps {
        script {
            // def changedFiles = sh(script: "git diff --name-only HEAD~1", 
            //                         returnStdout: true).trim().split("\n")

            def buildFolder      = 'MVP-Downstream-Builds'
            def homeDir          = 'ci-mvp-downstream-builds'
            def topLevelBranch   = 'master-ci-6005-postgresql'
            def downStreamBranch = 'master-ci-6005-downstream-builds'

            def nameBuilds = [
              "${buildFolder}/MVP-Downstream-Build-1/${downStreamBranch}",
              "${buildFolder}/MVP-Downstream-Build-2/${downStreamBranch}",
              "${buildFolder}/MVP-Downstream-Build-3/${downStreamBranch}"
            ]

            def dirBuilds = [
              "${homeDir}/downstream-build-1",
              "${homeDir}/downstream-build-2",
              "${homeDir}/downstream-build-3"
            ]

            def parallelJobs = [:]

            for (int i = 0; i < dirBuilds.size(); i++) {
              def idx = i // Required for proper closure capture
              def dirBuild  = dirBuilds[idx]
              def nameBuild = nameBuilds[idx]

              parallelJobs["Run-${idx + 1}"] = {
                echo "👉 Triggering downstream job: ${nameBuild}"
                build job: "${nameBuild}"
              }
            }

            parallel parallelJobs   // ← Jenkins waits for all to finish here

        }
      }
    }



  
    stage('Upload to S3 - Artifacts') {

      steps {
        container('runner') {
          sh """
            echo "📤 Uploading to S3..."

            aws s3 cp /home/jenkins/agent/${BUILD_BUNDLE_DUMMY_NAME} \
              ${env.AWS_S3_URL_ARTIFACTS}/${BUILD_BUNDLE_DUMMY_NAME} || echo "❌ Upload failed"

            aws s3 cp /home/jenkins/agent/${BUILD_SOURCE_DUMMY_NAME} \
              ${env.AWS_S3_URL_ARTIFACTS}/${BUILD_SOURCE_DUMMY_NAME} || echo "❌ Upload failed"
          """
        }
      }
    }


  }

  
}


/*
This Jenkinsfile is an EFS Validation script 
Current status:
- The agent used not is mounting successfully the EFS.

Status:
- This Jenkinsfile works fine - the EFS is mounted fs was change permision to write only for test purposes.

Purpose:
- It validates the EFS mount by checking if the directory is mounted.
- It creates a file in the EFS to confirm write access.
- It prints the contents of the EFS directory to verify the file creation.
- It uses a custom Docker image with kubectl installed for Kubernetes operations.

*/

