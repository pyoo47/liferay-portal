@Library('Liferay-Global-Shared-Libs') _

import com.liferay.TestBuild

pipeline {

  agent {
    kubernetes {
      yaml """
apiVersion: v1
kind: Pod
metadata:
  name: jenkins-efs-agent
  securityContext:
    fsGroup: 1000
  labels:
    jenkins: agent
spec:
  serviceAccountName: jenkins-agent
  containers:
    - name: jnlp
      image: jenkins/inbound-agent:3309.v27b_9314fd1a_4-4
      volumeMounts:
        - mountPath: /home/jenkins/agent
          name: efs-workspace
    - name: runner
      image: 300374333822.dkr.ecr.us-east-2.amazonaws.com/aws-liferay-runner:1.0.3
      command: ["cat"]
      tty: true
      volumeMounts:
        - mountPath: /home/jenkins/agent
          name: efs-workspace
        - mountPath: /home/jenkins/local
          name: workspace-volume
  volumes:
    - name: efs-workspace
      persistentVolumeClaim:
        claimName: jenkins-efs-pvc
    - name: workspace-volume
      emptyDir: {}
"""
    }
  }


  environment {
    GIT_REPO_URL = 'https://github.com/pablo-inchausti-caylent/liferay-portal.git'
    GIT_BRANCH   = 'master-ci-6005-postgresql'

    AWS_ACCOUNT_ID='300374333822'
    AWS_REGION='us-east-2'

    AWS_S3_BUCKET='liferayci-file-propagator-mvp'
    AWS_S3_PATH='build'


    // CUSTOM_BUILD_NUMBER = "${env.BUILD_NUMBER}"
    CUSTOM_BUILD_NUMBER = "1"

    AWS_S3_URL_ARTIFACTS="s3://${AWS_S3_BUCKET}/${AWS_S3_PATH}/${env.CUSTOM_BUILD_NUMBER}/artifacts"
    AWS_S3_URL_TESTS="s3://${AWS_S3_BUCKET}/${AWS_S3_PATH}/${env.CUSTOM_BUILD_NUMBER}/tests"

    BUILD_BUNDLE_NAME='liferay-portal-bundle-tomcat.tar.gz'
    BUILD_SOURCE_NAME='liferay-portal-source.tar.gz'

    BUILD_BUNDLE_DUMMY_NAME="bundle-${BUILD_BUNDLE_NAME}"
    BUILD_SOURCE_DUMMY_NAME="bundle-${BUILD_SOURCE_NAME}"

    // s3://liferayci-file-propagator-mvp/build/35/artifacts
    // s3://liferayci-file-propagator-mvp/build/35/tests

    // liferay-portal-bundle-tomcat.tar.gz  (~1.7gb)
    // liferay-portal-source.tar.gz         (~1.2gb)

    LOCAL_DIR_CHECKOUT  = "/home/jenkins/local/checkout"
    TARBALL_GIT_NAME    = "liferay-portal-repo-${env.CUSTOM_BUILD_NUMBER}.tar.gz"
    TARBALL_GIT_REPO    = "/home/jenkins/local/${TARBALL_GIT_NAME}"

    EFS_MOUNT_PATH                = "/home/jenkins/agent"
    EFS_LIFERAY_ARTIFACT_FOLDER   = "${EFS_MOUNT_PATH}/liferay-artifacts/build-${env.CUSTOM_BUILD_NUMBER}"
    EFS_LIFERAY_ARTIFACT_REPOS    = "${EFS_LIFERAY_ARTIFACT_FOLDER}/repo-github"
    EFS_LIFERAY_ARTIFACT_BUNDLES  = "${EFS_LIFERAY_ARTIFACT_FOLDER}/bundles"
    EFS_LIFERAY_ARTIFACT_TEST     = "${EFS_LIFERAY_ARTIFACT_FOLDER}/tests"

  }

  options {
    skipDefaultCheckout()
  }



  stages {

    stage('Print Environment') {
      steps {
        script {

          echo """
          Environment Variables:
          Branch      : ${env.BRANCH_NAME}
          Job Name    : ${env.JOB_NAME}
          Build Number: ${env.CUSTOM_BUILD_NUMBER}
          Workspace   : ${env.WORKSPACE}
          Git Commit  : ${env.GIT_COMMIT}
          Node Name   : ${env.NODE_NAME}

          AWS_S3_URL_ARTIFACTS : ${env.AWS_S3_URL_ARTIFACTS}
          AWS_S3_URL_TESTS     : ${env.AWS_S3_URL_TESTS}
          """


          echo "Testing Shared Libs"

          log.info    'Validation Shared Libs Integration'
          log.warning 'Liferay-Global-Shared-Libs is working fine'
          
          echo "kubectl exec -it ${env.NODE_NAME} -n liferay-jenkins -- bash"
        }
        // Or print everything
        // sh 'printenv'
      }
    }

    stage('Validate AWS Cli, IRSA and Kubectl (optional) ') {
      steps {
        container('runner') {

          echo '📦 Validate AWS CLI and IRSA...'

          sh '''
            aws --version || true 
            aws sts get-caller-identity || echo "❌ AWS CLI not configured or IRSA not working"
            aws s3 ls || echo "❌ AWS CLI S3 (IRSA) access not working"
          '''

          echo '📦 Validate Kubectl ...'
          sh '''
              kubectl  version || true
          '''
        }
      }
    }
    

    stage('Checkout') {
      steps {
        container('runner') {
          script {

            // Clean the target folder
            sh """
              echo '🧹 Dummy...'
              echo '🧹 Checkout Dummy - using tar.bz from builder-1...'
            """
            // // Define explicitly if not already
            // def LOCAL_DIR_CHECKOUT = '/home/jenkins/local/checkout'
            // def TARBALL_GIT_REPO = "/home/jenkins/local/liferay-portal-repo-${env.CUSTOM_BUILD_NUMBER}.tar.gz"

            // echo "📂 LOCAL_DIR_CHECKOUT: ${LOCAL_DIR_CHECKOUT}"
            // echo "📦 TARBALL_GIT_REPO: ${TARBALL_GIT_REPO}"

            // // Clean the target folder
            // sh """
            //   echo '🧹 Version 4...'
            //   echo '🧹 Cleaning checkout folder...'
            //   rm -rf ${LOCAL_DIR_CHECKOUT} && mkdir -p ${LOCAL_DIR_CHECKOUT}
            // """

            // withCredentials([
            //   usernamePassword(
            //     credentialsId: 'github-pat-pei',
            //     usernameVariable: 'GIT_USERNAME',
            //     passwordVariable: 'GIT_PASSWORD'
            //   )
            // ]) {
            //   sh """
            //     echo '📥 Manual clone in container context...'
            //     git clone --depth=1 \
            //               --branch ${env.GIT_BRANCH} \
            //          https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/pablo-inchausti-caylent/liferay-portal.git \
            //          ${LOCAL_DIR_CHECKOUT}
            //   """
            // }
          }

        }
      }
    }



    stage('Source Code Compress') {
      steps {
        container('runner') {
          script {

            // Define explicitly if not already
            def LOCAL_DIR_CHECKOUT = '/home/jenkins/local/checkout'
            def TARBALL_GIT_REPO = "/home/jenkins/local/liferay-portal-repo-${env.CUSTOM_BUILD_NUMBER}.tar.gz"

            // Clean the target folder
            sh """
              echo '🧹 Version 5.00 ...'
              echo '🧹 Cleaning checkout folder...'
              rm -rf ${LOCAL_DIR_CHECKOUT} && mkdir -p ${LOCAL_DIR_CHECKOUT}
              
              ls -la ${LOCAL_DIR_CHECKOUT}
            
              echo "📂 LOCAL_DIR_CHECKOUT: ${LOCAL_DIR_CHECKOUT}"
              echo "📦 TARBALL_GIT_REPO: ${TARBALL_GIT_REPO}"
            
              echo '📂 Folders ..  out source code (emulated)...'
              ls -la /home/jenkins/
              ls -la /home/jenkins/local
              ls -la /home/jenkins/local/checkout
              echo '📂 Checking out source code (emulated)...'
              
              # Move tarball to EFS workspace

              echo '📂 EFS workspace contents: (v1)'
              cp ${EFS_LIFERAY_ARTIFACT_REPOS}/${TARBALL_GIT_NAME} ${LOCAL_DIR_CHECKOUT}

              echo '📂 EFS workspace and local contents:'
              ls -al ${LOCAL_DIR_CHECKOUT}
              ls -al ${EFS_LIFERAY_ARTIFACT_REPOS}   


              echo '📦 Extracting tarball (with pigz)...'
              # tar       -xzf ${LOCAL_DIR_CHECKOUT}/${TARBALL_GIT_NAME} -C ${LOCAL_DIR_CHECKOUT}
              tar -I pigz -xf ${LOCAL_DIR_CHECKOUT}/${TARBALL_GIT_NAME} -C ${LOCAL_DIR_CHECKOUT}


              echo '📂 Extracted contents:  '
              ls -al ${LOCAL_DIR_CHECKOUT}
              echo '📂 Checking out source code (emulated) done...'
              rm -f ${LOCAL_DIR_CHECKOUT}/${TARBALL_GIT_NAME}
              echo '📂 Source code ready in ${LOCAL_DIR_CHECKOUT}'
              """

              
              sh """
                echo "LET's GO HERE WITH BUSY BOX x 7200"
                echo "🛑 Build complete. Pod is: ${env.NODE_NAME}"
                echo "Run this to debug:"
                echo "kubectl exec -it ${env.NODE_NAME} -n liferay-jenkins -- bash"
                sleep 7200
              """

          }
        }
      }
    }


    stage('Dynamic Downstream Builds') {
      steps {
        script {
                        
            echo "🔄 Starting dynamic downstream builds based on commit message..."
            echo "🔄 Using (Docker image 2.1) ... Version 2.5 "
            
            // def commitMessage = "[test: NONE ]"
            // def commitMessage = "[test: ALL ]"
            // def commitMessage = "[test: test-01-unit, test-03-db]"
            def commitMessage = "[test: test-01-unit]"

            try {
              commitMessage = sh(script: "git log -1 --pretty=%B", returnStdout: true).trim()
              echo "📩 Commit message found: ${commitMessage}"
            } catch (e) {
              echo "⚠️ Could not retrieve commit message. Using default: ${commitMessage}"
              echo "🔍 Reason: ${e.getMessage()}"
            }

            def selectedTests = TestBuild.fromCommitMessage(commitMessage) 

            echo "✅ Selected: ${selectedTests*.label.join(', ')}"

            def parallelJobs = [:]

            selectedTests.each { test ->
                def jobPath = TestBuild.getFullJobPath(test)
                def dirPath = TestBuild.getFullDirPath(test)

                echo "👉 Running: ${test.label}"
                echo "🔧 Job Path: ${jobPath}"
                echo "📁 Directory: ${dirPath}"

                build job: jobPath, 
                      parameters: [
                        string(name: 'PARENT_BUILD_NUMBER', value: env.CUSTOM_BUILD_NUMBER),
                        string(name: 'PARENT_GIT_COMMIT', value: env.GIT_COMMIT),
                        string(name: 'TARBALL_GIT_NAME', value: TARBALL_GIT_NAME),
                        string(name: 'TARBALL_GIT_REPO', value: TARBALL_GIT_REPO),
                        string(name: 'EFS_LIFERAY_ARTIFACT_FOLDER', value: env.EFS_LIFERAY_ARTIFACT_FOLDER),
                        string(name: 'EFS_LIFERAY_ARTIFACT_REPOS', value: env.EFS_LIFERAY_ARTIFACT_REPOS),
                        string(name: 'EFS_LIFERAY_ARTIFACT_BUNDLES', value: env.EFS_LIFERAY_ARTIFACT_BUNDLES),
                        string(name: 'EFS_LIFERAY_ARTIFACT_TEST', value: env.EFS_LIFERAY_ARTIFACT_TEST)
                      ]
            }

            parallel parallelJobs   // ← Jenkins waits for all to finish here

        }
      }
    }

  }


  // post {
  //   always {
