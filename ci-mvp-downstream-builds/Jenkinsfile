pipeline {
  agent {
    kubernetes {
      label 'liferay-agent-test'
      defaultContainer 'build'
      yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: jnlp
      image: jenkins/inbound-agent:latest
      resources:
        requests:
          memory: "512Mi"
          cpu: "500m"
    - name: build
      image: alpine
      command: ['cat']
      tty: true
      resources:
        requests:
          memory: "1Gi"
          cpu: "1"
  nodeSelector:
    jenkins-role: agent
  tolerations:
    - key: "jenkins-role"
      operator: "Equal"
      value: "agent"
      effect: "NoSchedule"
"""
    }
  }

  stages {
    stage('Sanity Check') {
      steps {
        container('build') {
          sh 'echo ✅ Minimal pod scheduled successfully!'
        }
      }
    }
  }
}