@Library('Liferay-Global-Shared-Libs') _

pipeline {

  agent {
    kubernetes {
      yaml """
apiVersion: v1
kind: Pod
metadata:
  name: jenkins-efs-agent
  labels:
    jenkins: agent
spec:
  serviceAccountName: jenkins-agent
  containers:
    - name: jnlp
      image: jenkins/inbound-agent:3309.v27b_9314fd1a_4-4
      volumeMounts:
        - mountPath: /home/jenkins/agent
          name: efs-workspace
    - name: runner
      image: 300374333822.dkr.ecr.us-east-2.amazonaws.com/my-custom-kubectl:1.3
      command: ["cat"]
      tty: true
      volumeMounts:
        - mountPath: /home/jenkins/agent
          name: efs-workspace
  volumes:
    - name: efs-workspace
      persistentVolumeClaim:
        claimName: jenkins-efs-pvc
"""
    }
  }

  options {
    skipDefaultCheckout()
  }

  stages {

    stage('Print Environment - v12 with mount EFS') {
      steps {
        script {

          echo "Testing Shared Libs"

          log.info 'Validation Liferay-Global-Shared-Libs'
          log.warning 'Nothing to do!'

          log.warning 'TODO - Read the EFS from a GUI ?'

          echo "Branch: ${env.BRANCH_NAME}"
          echo "Job Name: ${env.JOB_NAME}"
          echo "Build Number: ${env.BUILD_NUMBER}"
          echo "Workspace: ${env.WORKSPACE}"
          echo "Git Commit: ${env.GIT_COMMIT}"
        }
        // Or print everything
        // sh 'printenv'
      }
    }

    stage('Validate AWS Cli, IRSA and Kubectl (optional) ') {
      steps {
        container('runner') {
          echo '📦 Validate AWS CLI and IRSA...'
          sh '''
            aws --version || true 
            aws sts get-caller-identity || echo "❌ AWS CLI not configured or IRSA not working"
            aws s3 ls || echo "❌ AWS CLI S3 (IRSA) access not working"
          '''

          echo '📦 Validate Kubectl ...'
          sh '''
              kubectl  version || true
          '''
        }
      }
    }
    

     stage('Checkout Shallow') {
      steps {
        // container('runner') {
        //   checkout([
        //     $class: 'GitSCM',
        //     branches: [[name: "*/${env.GIT_BRANCH}"]],
        //     userRemoteConfigs: [[
        //       url: "${env.GIT_REPO_URL}",
        //       credentialsId: 'github-pat-pei'
        //     ]],
        //     extensions: [
        //       [$class: 'CloneOption', shallow: true, depth: 1, noTags: false, reference: '', timeout: 10]
        //     ]
        //   ])
        // }

          sh '''

            echo "🔍 Checking EFS mount at /home/jenkins/agent"
            mount | grep /home/jenkins/agent || echo "❌ EFS NOT mounted"

            date > /home/jenkins/agent/git-repo-emulation-gz.txt
            echo "📄 GitRepo emulation ." >> /home/jenkins/agent/git-repo-emulation-gz.txt

            ls -al /home/jenkins/agent
          '''
        
      }
    }





  }

  
}


/*
This Jenkinsfile is an EFS Validation script 
Current status:
- The agent used not is mounting successfully the EFS.

Status:
- This Jenkinsfile works fine - the EFS is mounted fs was change permision to write only for test purposes.

Purpose:
- It validates the EFS mount by checking if the directory is mounted.
- It creates a file in the EFS to confirm write access.
- It prints the contents of the EFS directory to verify the file creation.
- It uses a custom Docker image with kubectl installed for Kubernetes operations.

*/

