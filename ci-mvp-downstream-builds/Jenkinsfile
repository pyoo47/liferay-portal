/**
  * Jenkinsfile for Liferay MVP Downstream Builds
  * Version: 1.0.1
  * This Jenkinsfile defines a minimal pod configuration for testing purposes.
  * Also:
  * - Include 'AWS Caylent Runner' on a m5.4xlarge ready to build the bundle
  *  
  $ Result:
  * - I was able to build the bundle doing ssh (kubectl exe) on the AWS Caylent Runner container
  *
  * Satus: ✅ Minimal pod scheduled successfully
  */
pipeline {
  agent {
    kubernetes {
      label 'liferay-agent-test'
      defaultContainer 'build'
      yaml """
apiVersion: v1
kind: Pod
metadata:
  annotations:
    eks.amazonaws.com/role-arn: arn:aws:iam::300374333822:role/jenkins-irsa-role

spec:
  serviceAccountName: jenkins-agent

  containers:


    - name: jnlp
      image: jenkins/inbound-agent:latest
      resources:
        requests:
          memory: "512Mi"
          cpu: "500m"


    - name: build
      image: alpine
      command: ['cat']
      tty: true
      resources:
        requests:
          memory: "1Gi"
          cpu: "1"


    - name: aws-caylent-runner
      image: 300374333822.dkr.ecr.us-east-2.amazonaws.com/aws-caylent-runner:1.0.1
      command: ["cat"]
      tty: true
      resources:
        requests:
          cpu: "8"
          memory: "8Gi"
        limits:
          cpu: "16"
          memory: "16Gi"


    - name: aws-liferay-runner
      image: 300374333822.dkr.ecr.us-east-2.amazonaws.com/aws-liferay-runner:1.0.3
      command: ["cat"]
      tty: true



  nodeSelector:
    jenkins-role: agent
  tolerations:
    - key: "jenkins-role"
      operator: "Equal"
      value: "agent"
      effect: "NoSchedule"
"""
    }
  }

  stages {
    
    stage('Sanity Check') {
      steps {
        container('build') {
          sh 'echo ✅ Minimal pod scheduled successfully! v1.0.1 <'
        }
      }
    }

    stage('Run AWS Caylent Runner') {
      steps {
        container('aws-caylent-runner') {
          sh 'echo Running AWS Caylent Runner...'
          // Add commands to run the AWS Caylent Runner here
        }
      }
    }

    stage('Run AWS Liferay Runner') {
      steps {
        container('aws-liferay-runner') {
          sh 'echo Running AWS Liferay Runner...'
          // Add commands to run the AWS Liferay Runner here
        }
      }
    }


  }


  post {
    always {
      input message: 'Finish the pipeline?', ok: 'Yes, proceed'
      echo "🔚 Pipeline completed. Cleaning up workspace..."
    
    }
  }


}